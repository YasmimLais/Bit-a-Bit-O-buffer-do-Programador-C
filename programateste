            }
        }

        // Sentido para Direita:
        if (Sentido == 'D'){
            
            for (int d = 1; d <= Passos; d++){ // Print quantidade de passos. 
                printf(".");
            }
            PosicaoColuna += Passos; // Determina Colunas 
        }

        // Sentido para Esquerda:
        if (Sentido == 'E'){

            // Caso exista b como anterior + passo
            if (SentidoAnterior == 'B'){   
                if (Passos <= PosicaoColuna){
                    Passos +=1; 
                }

                printf("\n");
            } 
            // Passos maior que espaço a direita
            if (Passos > PosicaoColuna){
                printf ("Informacao invalida");
                
            } else if (Passos < PosicaoColuna){ // Se passos menor que a coluna, é valido. 
                
                for (int x = 1; x <= Passos; x++){ // Roda quantidade de passo que vai dar
                    for (int y = 1; y <= PosicaoColuna - Passos; y++) {
                        printf(" ");
                    }
                    printf(".");
                      
                        
                    }       
                }
            
            }                  
        }
    
    return 0;
}

