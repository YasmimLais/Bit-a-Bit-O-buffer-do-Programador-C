#include <stdio.h>

int main(){

    int QntEntradas, Passos, Colunas, PassosDireita;
    char Sentido, SentidoAnterior;
    int baixo = 0, esquerda = 0, direita = 0;
    int PosicaoColuna = 0;

    scanf ("%d ", &QntEntradas);

    // LAÇO PRINCIPAL: vai indicar quantas ações devos exercutar
    for (int i = 1; i <= QntEntradas; i++ ){

        scanf("%d %c", &Passos, &Sentido); // Recebe Passos e Sentidos

        // SENTIDOS:

        // Sentido para Baixo: 
        if (Sentido == 'B'){
            
            if (i ==  QntEntradas){ 
                Passos += 1;
            }

             // Um for para vê os passos para baixo = "." e outro para verificar a Posição:
            for (int b = 1; b <= Passos ; b++){
                printf("\n");
                for (int c = 1; c <= PosicaoColuna; c++) {
