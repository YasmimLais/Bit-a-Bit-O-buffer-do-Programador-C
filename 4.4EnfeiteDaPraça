#include <stdio.h>

int main() {

    int linhas, colunas; 

    scanf("%d %d", &linhas, &colunas);
    char matriz[linhas][colunas];

    // Recebe a matriz
    for (int i = 0; i < linhas; i++)
        for (int j = 0; j < colunas; j++)
            scanf(" %c", &matriz[i][j]); 

    // Pecorre a matriz em busca do 'P'
    for (int i = 0; i < linhas; i++) {
        for (int j = 0; j < colunas; j++) {
            if (matriz[i][j] == 'P') {

                // Vizinho diretos
                if (i - 1 >= 0 && (matriz[i-1][j] == '-' ||  matriz[i-1][j] == 'x'))
                    matriz[i-1][j] = '+';

                if (i + 1 < linhas && (matriz[i+1][j] == '-' || matriz[i+1][j] == 'x'))
                    matriz[i+1][j] = '+';

                if (j - 1 >= 0  && (matriz[i][j-1] == '-' || matriz[i][j-1] == 'x'))
                    matriz[i][j-1] = '+';

                if (j + 1 < colunas && (matriz[i][j+1] == '-' || matriz[i][j+1] == 'x'))
                    matriz[i][j+1] = '+';

                //  Vizinho diagonal
                if (i-1 >= 0 && j-1 >= 0 && matriz[i-1][j-1] == '-')
                    matriz[i-1][j-1] = 'x';

                if (i-1 >= 0 && j+1 < colunas && matriz[i-1][j+1] == '-')
                    matriz[i-1][j+1] =  'x';

                if (i+1 < linhas && j-1 >= 0 && matriz[i+1][j-1] == '-')
                    matriz[i+1][j-1] = 'x';

                if (i+1 < linhas && j+1 < colunas && matriz[i+1][j+1] == '-')
                    matriz[i+1][j+1] = 'x';
            }
        }
    }

    // Matriz alterada
    for (int i = 0; i < linhas; i++) {
        for (int j = 0; j < colunas; j++)
            printf("%c", matriz[i][j]);
        printf("\n");
    }

    return 0;
}
